# Copy to .env and fill in. Never commit .env.

DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=url.mekhroj.com,www.url.mekhroj.com
# Comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=
# Where unknown or inactive short codes redirect to
DEFAULT_REDIRECT_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=url_shortener_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port the prod database is published on (127.0.0.1 only)
DB_PORT=

SENTRY_DSN=

# Optional
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SECURE_HSTS_SECONDS=31536000
# AUTH_THROTTLE_RATE=10/min
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
