{
  "name": "spur",
  "private": true,
  "version": "0.1.0",
  "description": "The Spur web app: create and organise short links and see where their clicks come from.",
  "license": "MIT",
  "author": "Mehroj Majidov",
  "keywords": ["url-shortener", "link-shortener", "click-analytics", "react", "vite", "typescript"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehroj-r/url-shortener.git",
    "directory": "frontend"
  },
  "bugs": "https://github.com/mehroj-r/url-shortener/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^1.57.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
